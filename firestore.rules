rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // Global Hardened Primitives
    // =========================================================================
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidLookupKey(key) {
      return key is string && key.size() == 64 && key.matches('^[a-f0-9]{64}$');
    }

    function isValidCounterId(counterId) {
      return counterId is string && counterId.matches('^registrations_20[0-9]{2}$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    // Single strictly authorized admin email (case-insensitive, verified token required)
    function isAdmin() {
      return isVerifiedUser() &&
        request.auth.token.email is string &&
        request.auth.token.email.lower() == 'godrikuop@gmail.com';
    }

    function isValidGuestUserId(uid) {
      return uid is string &&
        uid.size() >= 14 &&
        uid.size() <= 72 &&
        uid.matches('^guest_[a-zA-Z0-9_\\-]+$');
    }

    function isValidSubmitterUserId(uid) {
      return isValidGuestUserId(uid) || (isSignedIn() && uid == request.auth.uid);
    }

    function isOptionalNumberInRange(data, key, minVal, maxVal) {
      return !(key in data) || data[key] == null || (
        (data[key] is int || data[key] is float) &&
        data[key] >= minVal &&
        data[key] <= maxVal
      );
    }

    function isOptionalString(data, key, maxLen) {
      return !(key in data) || (data[key] is string && data[key].size() <= maxLen);
    }

    function isValidStringList(listVal, maxItems) {
      return listVal is list &&
        listVal.size() <= maxItems &&
        (listVal.size() == 0 || listVal[0] is string);
    }

    function isOptionalStringList(data, key, maxItems) {
      return !(key in data) || isValidStringList(data[key], maxItems);
    }

    // =========================================================================
    // Entity Validation Blueprints (Anti-Update-Gap & Volumetric Guards)
    // =========================================================================
    function isValidRoom(data) {
      return data.keys().hasAll(['name', 'roomNumber', 'roomType', 'maxGuests', 'status', 'facilities', 'createdAt', 'updatedAt', 'updatedBy']) &&
        data.keys().hasOnly([
          'name', 'roomNumber', 'roomType', 'size', 'maxGuests', 'availableBeds',
          'price1', 'price2', 'price3', 'price4', 'extraPersonPrice',
          'securityDeposit', 'advanceRent',
          'facilities', 'status', 'description', 'imageUrl', 'photos', 'sortOrder',
          'createdAt', 'updatedAt', 'updatedBy'
        ]) &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
        data.roomNumber is string && data.roomNumber.size() >= 1 && data.roomNumber.size() <= 40 &&
        data.roomType is string && data.roomType.size() >= 1 && data.roomType.size() <= 60 &&
        isOptionalString(data, 'size', 60) &&
        (data.maxGuests is int || data.maxGuests is float) && data.maxGuests >= 1 && data.maxGuests <= 20 &&
        isOptionalNumberInRange(data, 'availableBeds', 0, 20) &&
        isOptionalNumberInRange(data, 'price1', 0, 100000) &&
        isOptionalNumberInRange(data, 'price2', 0, 100000) &&
        isOptionalNumberInRange(data, 'price3', 0, 100000) &&
        isOptionalNumberInRange(data, 'price4', 0, 100000) &&
        isOptionalNumberInRange(data, 'extraPersonPrice', 0, 50000) &&
        isOptionalNumberInRange(data, 'securityDeposit', 0, 100000) &&
        isOptionalNumberInRange(data, 'advanceRent', 0, 100000) &&
        isValidStringList(data.facilities, 20) &&
        data.status in ['available', 'occupied', 'maintenance', 'cleaning'] &&
        isOptionalString(data, 'description', 1200) &&
        isOptionalString(data, 'imageUrl', 250000) &&
        isOptionalStringList(data, 'photos', 6) &&
        isOptionalNumberInRange(data, 'sortOrder', 0, 1000) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp &&
        data.updatedBy is string && data.updatedBy == request.auth.uid;
    }

    function isValidFacility(data) {
      return data.keys().hasAll(['name', 'icon', 'enabled', 'createdAt', 'updatedAt', 'updatedBy']) &&
        data.keys().hasOnly(['name', 'icon', 'imageUrl', 'description', 'enabled', 'sortOrder', 'createdAt', 'updatedAt', 'updatedBy']) &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 100 &&
        data.icon is string && data.icon.size() >= 1 && data.icon.size() <= 40 &&
        isOptionalString(data, 'imageUrl', 250000) &&
        isOptionalString(data, 'description', 500) &&
        data.enabled is bool &&
        isOptionalNumberInRange(data, 'sortOrder', 0, 1000) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp &&
        data.updatedBy is string && data.updatedBy == request.auth.uid;
    }

    function isValidGalleryItem(data) {
      return data.keys().hasAll(['title', 'category', 'imageUrl', 'createdAt', 'updatedAt', 'updatedBy']) &&
        data.keys().hasOnly(['title', 'category', 'imageUrl', 'description', 'sortOrder', 'createdAt', 'updatedAt', 'updatedBy']) &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
        data.category in ['hostel', 'lodge', 'rooms', 'bathroom', 'parking', 'rooftop', 'study_area', 'facilities', 'other', 'surroundings', 'owner'] &&
        data.imageUrl is string && data.imageUrl.size() >= 1 && data.imageUrl.size() <= 250000 &&
        isOptionalString(data, 'description', 400) &&
        isOptionalNumberInRange(data, 'sortOrder', 0, 1000) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp &&
        data.updatedBy is string && data.updatedBy == request.auth.uid;
    }

    function isValidRule(data) {
      return data.keys().hasAll(['title', 'enabled', 'sortOrder', 'createdAt', 'updatedAt', 'updatedBy']) &&
        data.keys().hasOnly([
          'title', 'description', 'englishLabel', 'icon', 'variant', 'category', 'highlights',
          'sortOrder', 'enabled', 'createdAt', 'updatedAt', 'updatedBy'
        ]) &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 140 &&
        isOptionalString(data, 'description', 800) &&
        isOptionalString(data, 'englishLabel', 140) &&
        isOptionalString(data, 'icon', 40) &&
        (!('variant' in data) || data.variant in ['default', 'important', 'warning']) &&
        isOptionalString(data, 'category', 60) &&
        isOptionalStringList(data, 'highlights', 10) &&
        (data.sortOrder is int || data.sortOrder is float) && data.sortOrder >= 0 && data.sortOrder <= 1000 &&
        data.enabled is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp &&
        data.updatedBy is string && data.updatedBy == request.auth.uid;
    }

    function isValidGeneralSettings(data) {
      return data.keys().hasAll(['lodgeName', 'lodgeNameHindi', 'updatedAt', 'updatedBy']) &&
        data.keys().hasOnly([
          'lodgeName', 'lodgeNameHindi', 'introGreeting', 'introSubtitle',
          'welcomeBannerText', 'homeTagline', 'aboutLodge', 'monthlyStayInfo', 'heroImageUrl',
          'logoUrl', 'dataRetentionPolicy',
          'startingPrice', 'priceNote',
          'defaultPrice1', 'defaultPrice2', 'defaultPrice3', 'defaultPrice4',
          'defaultSecurityDeposit',
          'checkInTime', 'checkOutTime', 'updatedAt', 'updatedBy'
        ]) &&
        data.lodgeName is string && data.lodgeName.size() >= 1 && data.lodgeName.size() <= 120 &&
        data.lodgeNameHindi is string && data.lodgeNameHindi.size() >= 1 && data.lodgeNameHindi.size() <= 120 &&
        isOptionalString(data, 'introGreeting', 100) &&
        isOptionalString(data, 'introSubtitle', 200) &&
        isOptionalString(data, 'welcomeBannerText', 300) &&
        isOptionalString(data, 'homeTagline', 200) &&
        isOptionalString(data, 'aboutLodge', 2000) &&
        isOptionalString(data, 'monthlyStayInfo', 1000) &&
        isOptionalString(data, 'heroImageUrl', 250000) &&
        isOptionalString(data, 'logoUrl', 250000) &&
        isOptionalString(data, 'dataRetentionPolicy', 800) &&
        isOptionalNumberInRange(data, 'startingPrice', 0, 100000) &&
        isOptionalString(data, 'priceNote', 400) &&
        isOptionalNumberInRange(data, 'defaultPrice1', 0, 100000) &&
        isOptionalNumberInRange(data, 'defaultPrice2', 0, 100000) &&
        isOptionalNumberInRange(data, 'defaultPrice3', 0, 100000) &&
        isOptionalNumberInRange(data, 'defaultPrice4', 0, 100000) &&
        isOptionalNumberInRange(data, 'defaultSecurityDeposit', 0, 100000) &&
        isOptionalString(data, 'checkInTime', 120) &&
        isOptionalString(data, 'checkOutTime', 120) &&
        data.updatedAt is timestamp &&
        data.updatedBy is string && data.updatedBy == request.auth.uid;
    }

    function isValidContactSettings(data) {
      return data.keys().hasAll(['updatedAt', 'updatedBy']) &&
        data.keys().hasOnly(['phone', 'whatsapp', 'email', 'otherInfo', 'updatedAt', 'updatedBy']) &&
        isOptionalString(data, 'phone', 30) &&
        isOptionalString(data, 'whatsapp', 30) &&
        isOptionalString(data, 'email', 120) &&
        isOptionalString(data, 'otherInfo', 500) &&
        data.updatedAt is timestamp &&
        data.updatedBy is string && data.updatedBy == request.auth.uid;
    }

    function isValidLocationSettings(data) {
      return data.keys().hasAll(['updatedAt', 'updatedBy']) &&
        data.keys().hasOnly(['address', 'landmark', 'city', 'googleMapsUrl', 'updatedAt', 'updatedBy']) &&
        isOptionalString(data, 'address', 500) &&
        isOptionalString(data, 'landmark', 200) &&
        isOptionalString(data, 'city', 100) &&
        isOptionalString(data, 'googleMapsUrl', 1000) &&
        data.updatedAt is timestamp &&
        data.updatedBy is string && data.updatedBy == request.auth.uid;
    }

    function isValidParkingSettings(data) {
      return data.keys().hasAll(['available', 'bikeParking', 'carParking', 'updatedAt', 'updatedBy']) &&
        data.keys().hasOnly([
          'available', 'headline', 'bikeParking', 'carParking',
          'capacity', 'rules', 'extraCharge', 'imageUrl', 'updatedAt', 'updatedBy'
        ]) &&
        data.available is bool &&
        isOptionalString(data, 'headline', 200) &&
        data.bikeParking is bool &&
        data.carParking is bool &&
        isOptionalString(data, 'capacity', 120) &&
        isOptionalString(data, 'rules', 800) &&
        isOptionalString(data, 'extraCharge', 120) &&
        isOptionalString(data, 'imageUrl', 250000) &&
        data.updatedAt is timestamp &&
        data.updatedBy is string && data.updatedBy == request.auth.uid;
    }

    function isValidRooftopSettings(data) {
      return data.keys().hasAll(['available', 'features', 'updatedAt', 'updatedBy']) &&
        data.keys().hasOnly(['available', 'headline', 'description', 'features', 'imageUrl', 'updatedAt', 'updatedBy']) &&
        data.available is bool &&
        isOptionalString(data, 'headline', 200) &&
        isOptionalString(data, 'description', 1000) &&
        isValidStringList(data.features, 15) &&
        isOptionalString(data, 'imageUrl', 250000) &&
        data.updatedAt is timestamp &&
        data.updatedBy is string && data.updatedBy == request.auth.uid;
    }

    function isValidOwnerProfile(data) {
      return data.keys().hasAll(['name', 'role', 'updatedAt', 'updatedBy']) &&
        data.keys().hasOnly(['name', 'role', 'photoUrl', 'about', 'phone', 'whatsapp', 'email', 'address', 'updatedAt', 'updatedBy']) &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 100 &&
        data.role is string && data.role.size() >= 1 && data.role.size() <= 100 &&
        isOptionalString(data, 'photoUrl', 250000) &&
        isOptionalString(data, 'about', 1500) &&
        isOptionalString(data, 'phone', 30) &&
        isOptionalString(data, 'whatsapp', 30) &&
        isOptionalString(data, 'email', 120) &&
        isOptionalString(data, 'address', 500) &&
        data.updatedAt is timestamp &&
        data.updatedBy is string && data.updatedBy == request.auth.uid;
    }

    function isValidBooking(data) {
      return data.keys().hasAll(['guestName', 'roomName', 'guestsCount', 'status', 'userId', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly([
          'guestName', 'guestPhone', 'roomId', 'roomName', 'guestsCount',
          'checkInDate', 'checkOutDate', 'totalAmount', 'status', 'notes',
          'userId', 'createdAt', 'updatedAt'
        ]) &&
        data.guestName is string && data.guestName.size() >= 1 && data.guestName.size() <= 100 &&
        isOptionalString(data, 'guestPhone', 25) &&
        isOptionalString(data, 'roomId', 128) &&
        data.roomName is string && data.roomName.size() >= 1 && data.roomName.size() <= 120 &&
        (data.guestsCount is int || data.guestsCount is float) && data.guestsCount >= 1 && data.guestsCount <= 20 &&
        isOptionalString(data, 'checkInDate', 30) &&
        isOptionalString(data, 'checkOutDate', 30) &&
        isOptionalNumberInRange(data, 'totalAmount', 0, 1000000) &&
        data.status in ['pending', 'confirmed', 'checked_in', 'completed', 'cancelled'] &&
        isOptionalString(data, 'notes', 500) &&
        data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidUserAccount(data, userId) {
      return data.keys().hasAll(['uid', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'displayName', 'email', 'createdAt', 'updatedAt']) &&
        data.uid is string && data.uid == userId &&
        isOptionalString(data, 'displayName', 120) &&
        isOptionalString(data, 'email', 120) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidAdminRecord(data) {
      return data.keys().hasAll(['email', 'addedBy', 'createdAt']) &&
        data.keys().hasOnly(['email', 'addedBy', 'createdAt']) &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 120 &&
        data.addedBy is string && data.addedBy == request.auth.uid &&
        data.createdAt is timestamp;
    }

    function isValidRegistrationCounter(data) {
      return data.keys().hasAll(['year', 'lastNumber', 'updatedAt']) &&
        data.keys().hasOnly(['year', 'lastNumber', 'updatedAt']) &&
        data.year is int && data.year >= 2024 && data.year <= 2100 &&
        data.lastNumber is int && data.lastNumber >= 1 && data.lastNumber <= 999999 &&
        data.updatedAt is timestamp;
    }

    // Expression-budgeted StayRegistration validation (stays far below Firestore's 1,000-expression ceiling)
    function isValidStayRegistrationCore(d) {
      return d.registrationId is string && d.registrationId.size() >= 4 && d.registrationId.size() <= 40 &&
        d.userId is string && d.userId.size() >= 1 && d.userId.size() <= 128 &&
        (!('lookupKey' in d) || d.lookupKey == '' || isValidLookupKey(d.lookupKey)) &&
        d.status in [
          'submitted', 'pdf_generated', 'printed', 'signed_copy_received',
          'pending', 'approved', 'rejected', 'room_assigned', 'active', 'completed'
        ] &&
        d.fullName is string && d.fullName.size() >= 1 && d.fullName.size() <= 120 &&
        d.gender is string && d.gender.size() >= 1 && d.gender.size() <= 30 &&
        d.mobile is string && d.mobile.size() >= 8 && d.mobile.size() <= 25 &&
        d.addressHouse is string && d.addressHouse.size() >= 1 && d.addressHouse.size() <= 200 &&
        d.addressDistrict is string && d.addressDistrict.size() >= 1 && d.addressDistrict.size() <= 100 &&
        d.addressState is string && d.addressState.size() >= 1 && d.addressState.size() <= 100 &&
        d.addressPin is string && d.addressPin.size() >= 4 && d.addressPin.size() <= 15 &&
        d.fatherName is string && d.fatherName.size() >= 1 && d.fatherName.size() <= 120 &&
        d.motherName is string && d.motherName.size() >= 1 && d.motherName.size() <= 120 &&
        d.parentMobile is string && d.parentMobile.size() >= 8 && d.parentMobile.size() <= 25 &&
        d.idProofType in ['Aadhaar Card', 'Other Valid ID'] &&
        d.roomPreference in ['Single', 'Double', 'Triple'] &&
        d.joiningDate is string && d.joiningDate.size() >= 4 && d.joiningDate.size() <= 30 &&
        d.stayDuration is string && d.stayDuration.size() >= 1 && d.stayDuration.size() <= 60 &&
        d.agreementAccepted is bool && d.agreementAccepted == true &&
        d.registrationDateIST is string && d.registrationDateIST.size() >= 6 && d.registrationDateIST.size() <= 30 &&
        d.registrationTimeIST is string && d.registrationTimeIST.size() >= 4 && d.registrationTimeIST.size() <= 30 &&
        d.createdAt is timestamp &&
        d.updatedAt is timestamp;
    }

    function isValidStayRegistrationExtras(d) {
      return (!('addressPostOffice' in d) || (d.addressPostOffice is string && d.addressPostOffice.size() <= 120)) &&
        (!('emergencyContact' in d) || (d.emergencyContact is string && d.emergencyContact.size() <= 30)) &&
        (!('emergencyRelation' in d) || (d.emergencyRelation is string && d.emergencyRelation.size() <= 60)) &&
        (!('idProofFileName' in d) || (d.idProofFileName is string && d.idProofFileName.size() <= 180)) &&
        (!('idProofMimeType' in d) || (d.idProofMimeType is string && d.idProofMimeType.size() <= 80)) &&
        (!('idProofStoragePath' in d) || (d.idProofStoragePath is string && d.idProofStoragePath.size() <= 400)) &&
        (!('photoStoragePath' in d) || (d.photoStoragePath is string && d.photoStoragePath.size() <= 400)) &&
        (!('signatureStoragePath' in d) || (d.signatureStoragePath is string && d.signatureStoragePath.size() <= 400)) &&
        (!('signedDocFileName' in d) || (d.signedDocFileName is string && d.signedDocFileName.size() <= 180)) &&
        (!('signedDocMimeType' in d) || (d.signedDocMimeType is string && d.signedDocMimeType.size() <= 80)) &&
        (!('signedDocStoragePath' in d) || (d.signedDocStoragePath is string && d.signedDocStoragePath.size() <= 400)) &&
        (!('storageBackend' in d) || d.storageBackend in ['firebase_storage', 'firestore_private']) &&
        (!('selectedRoomId' in d) || (d.selectedRoomId is string && d.selectedRoomId.size() <= 128)) &&
        (!('selectedRoomName' in d) || (d.selectedRoomName is string && d.selectedRoomName.size() <= 120)) &&
        (!('assignedRoomNumber' in d) || (d.assignedRoomNumber is string && d.assignedRoomNumber.size() <= 40)) &&
        (!('monthlyRent' in d) || d.monthlyRent == null || ((d.monthlyRent is int || d.monthlyRent is float) && d.monthlyRent >= 0 && d.monthlyRent <= 100000)) &&
        (!('securityDeposit' in d) || d.securityDeposit == null || ((d.securityDeposit is int || d.securityDeposit is float) && d.securityDeposit >= 0 && d.securityDeposit <= 100000)) &&
        (!('advanceRent' in d) || d.advanceRent == null || ((d.advanceRent is int || d.advanceRent is float) && d.advanceRent >= 0 && d.advanceRent <= 100000)) &&
        (!('totalPayable' in d) || d.totalPayable == null || ((d.totalPayable is int || d.totalPayable is float) && d.totalPayable >= 0 && d.totalPayable <= 500000)) &&
        (!('agreementVersion' in d) || (d.agreementVersion is string && d.agreementVersion.size() <= 40)) &&
        (!('pdfGeneratedAtIST' in d) || (d.pdfGeneratedAtIST is string && d.pdfGeneratedAtIST.size() <= 40)) &&
        (!('statusUpdatedAtIST' in d) || (d.statusUpdatedAtIST is string && d.statusUpdatedAtIST.size() <= 40)) &&
        (!('signedDocUploadedAtIST' in d) || (d.signedDocUploadedAtIST is string && d.signedDocUploadedAtIST.size() <= 40)) &&
        (!('updatedAtIST' in d) || (d.updatedAtIST is string && d.updatedAtIST.size() <= 40)) &&
        (!('adminNotes' in d) || (d.adminNotes is string && d.adminNotes.size() <= 600));
    }

    function isValidStayRegistration(d) {
      return d.keys().hasAll([
          'registrationId', 'userId', 'status', 'fullName', 'gender', 'mobile',
          'addressHouse', 'addressDistrict', 'addressState', 'addressPin',
          'fatherName', 'motherName', 'parentMobile',
          'idProofType', 'roomPreference', 'joiningDate', 'stayDuration',
          'agreementAccepted', 'registrationDateIST', 'registrationTimeIST',
          'createdAt', 'updatedAt'
        ]) &&
        d.keys().hasOnly([
          'registrationId', 'userId', 'lookupKey', 'status', 'fullName', 'dateOfBirth', 'gender', 'mobile', 'email',
          'addressHouse', 'addressPostOffice', 'addressDistrict', 'addressState', 'addressPin',
          'fatherName', 'motherName', 'parentMobile', 'parentAddress', 'emergencyContact', 'emergencyRelation',
          'idProofType', 'idProofFileName', 'idProofMimeType',
          'idProofStoragePath', 'photoStoragePath', 'signatureStoragePath',
          'signedDocFileName', 'signedDocMimeType', 'signedDocStoragePath',
          'storageBackend',
          'roomPreference', 'selectedRoomId', 'selectedRoomName', 'assignedRoomNumber',
          'monthlyRent', 'securityDeposit', 'advanceRent', 'totalPayable',
          'joiningDate', 'stayDuration', 'agreementAccepted', 'agreementVersion',
          'registrationDateIST', 'registrationTimeIST',
          'pdfGeneratedAtIST', 'statusUpdatedAtIST', 'signedDocUploadedAtIST', 'updatedAtIST',
          'adminNotes',
          'createdAt', 'updatedAt'
        ]) &&
        isValidStayRegistrationCore(d) &&
        isValidStayRegistrationExtras(d);
    }

    function isValidRegistrationDocument(data) {
      return data.keys().hasAll(['docType', 'userId', 'mimeType', 'dataUrl', 'createdAt']) &&
        data.keys().hasOnly(['docType', 'userId', 'fileName', 'mimeType', 'dataUrl', 'createdAt']) &&
        data.docType in ['photo', 'id_proof', 'signature', 'signed_document'] &&
        data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
        (!('fileName' in data) || (data.fileName is string && data.fileName.size() <= 180)) &&
        data.mimeType is string && data.mimeType.size() >= 3 && data.mimeType.size() <= 80 &&
        data.dataUrl is string && data.dataUrl.size() >= 20 && data.dataUrl.size() <= 900000 &&
        data.createdAt is timestamp;
    }

    function isValidRegistrationLookup(d) {
      return d.keys().hasAll([
          'registrationId', 'registrationDocId', 'status', 'fullName', 'gender', 'mobile',
          'addressHouse', 'addressDistrict', 'addressState', 'addressPin',
          'fatherName', 'motherName', 'parentMobile',
          'idProofType', 'roomPreference', 'joiningDate', 'stayDuration',
          'registrationDateIST', 'registrationTimeIST', 'createdAt', 'updatedAt'
        ]) &&
        d.keys().hasOnly([
          'registrationId', 'registrationDocId', 'status', 'fullName', 'gender', 'mobile',
          'addressHouse', 'addressPostOffice', 'addressDistrict', 'addressState', 'addressPin',
          'fatherName', 'motherName', 'parentMobile', 'emergencyContact', 'emergencyRelation',
          'idProofType', 'idProofFileName',
          'roomPreference', 'selectedRoomName', 'assignedRoomNumber',
          'monthlyRent', 'securityDeposit', 'advanceRent', 'totalPayable',
          'joiningDate', 'stayDuration',
          'registrationDateIST', 'registrationTimeIST',
          'photoDataUrl', 'createdAt', 'updatedAt'
        ]) &&
        d.registrationId is string && d.registrationId.size() >= 4 && d.registrationId.size() <= 40 &&
        isValidId(d.registrationDocId) &&
        d.status in [
          'submitted', 'pdf_generated', 'printed', 'signed_copy_received',
          'pending', 'approved', 'rejected', 'room_assigned', 'active', 'completed'
        ] &&
        d.fullName is string && d.fullName.size() >= 1 && d.fullName.size() <= 120 &&
        d.gender is string && d.gender.size() >= 1 && d.gender.size() <= 30 &&
        d.mobile is string && d.mobile.size() >= 8 && d.mobile.size() <= 25 &&
        d.addressHouse is string && d.addressHouse.size() >= 1 && d.addressHouse.size() <= 200 &&
        (!('addressPostOffice' in d) || (d.addressPostOffice is string && d.addressPostOffice.size() <= 120)) &&
        d.addressDistrict is string && d.addressDistrict.size() >= 1 && d.addressDistrict.size() <= 100 &&
        d.addressState is string && d.addressState.size() >= 1 && d.addressState.size() <= 100 &&
        d.addressPin is string && d.addressPin.size() >= 4 && d.addressPin.size() <= 15 &&
        d.fatherName is string && d.fatherName.size() >= 1 && d.fatherName.size() <= 120 &&
        d.motherName is string && d.motherName.size() >= 1 && d.motherName.size() <= 120 &&
        d.parentMobile is string && d.parentMobile.size() >= 8 && d.parentMobile.size() <= 25 &&
        (!('emergencyContact' in d) || (d.emergencyContact is string && d.emergencyContact.size() <= 30)) &&
        (!('emergencyRelation' in d) || (d.emergencyRelation is string && d.emergencyRelation.size() <= 60)) &&
        d.idProofType in ['Aadhaar Card', 'Other Valid ID'] &&
        (!('idProofFileName' in d) || (d.idProofFileName is string && d.idProofFileName.size() <= 180)) &&
        d.roomPreference in ['Single', 'Double', 'Triple'] &&
        (!('selectedRoomName' in d) || (d.selectedRoomName is string && d.selectedRoomName.size() <= 120)) &&
        (!('assignedRoomNumber' in d) || (d.assignedRoomNumber is string && d.assignedRoomNumber.size() <= 40)) &&
        (!('monthlyRent' in d) || d.monthlyRent == null || ((d.monthlyRent is int || d.monthlyRent is float) && d.monthlyRent >= 0 && d.monthlyRent <= 100000)) &&
        (!('securityDeposit' in d) || d.securityDeposit == null || ((d.securityDeposit is int || d.securityDeposit is float) && d.securityDeposit >= 0 && d.securityDeposit <= 100000)) &&
        (!('advanceRent' in d) || d.advanceRent == null || ((d.advanceRent is int || d.advanceRent is float) && d.advanceRent >= 0 && d.advanceRent <= 100000)) &&
        (!('totalPayable' in d) || d.totalPayable == null || ((d.totalPayable is int || d.totalPayable is float) && d.totalPayable >= 0 && d.totalPayable <= 500000)) &&
        d.joiningDate is string && d.joiningDate.size() >= 4 && d.joiningDate.size() <= 30 &&
        d.stayDuration is string && d.stayDuration.size() >= 1 && d.stayDuration.size() <= 60 &&
        d.registrationDateIST is string && d.registrationDateIST.size() >= 6 && d.registrationDateIST.size() <= 30 &&
        d.registrationTimeIST is string && d.registrationTimeIST.size() >= 4 && d.registrationTimeIST.size() <= 30 &&
        (!('photoDataUrl' in d) || (d.photoDataUrl is string && d.photoDataUrl.size() <= 400000)) &&
        d.createdAt is timestamp &&
        d.updatedAt is timestamp;
    }

    // =========================================================================
    // Public Hostel Showcase Collections (Public Read, Verified Admin Write)
    // =========================================================================
    match /rooms/{roomId} {
      allow get: if isValidId(roomId);
      allow list: if true;
      allow create: if isSignedIn() &&
        isValidId(roomId) &&
        isValidRoom(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        isAdmin();
      allow update: if isSignedIn() &&
        isValidId(roomId) &&
        isValidRoom(incoming()) &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'name', 'roomNumber', 'roomType', 'size', 'maxGuests', 'availableBeds',
          'price1', 'price2', 'price3', 'price4', 'extraPersonPrice',
          'securityDeposit', 'advanceRent',
          'facilities', 'status', 'description', 'imageUrl', 'photos', 'sortOrder',
          'updatedAt', 'updatedBy'
        ]) &&
        isAdmin();
      allow delete: if isSignedIn() && isValidId(roomId) && isAdmin();
    }

    match /facilities/{facilityId} {
      allow get: if isValidId(facilityId);
      allow list: if true;
      allow create: if isSignedIn() &&
        isValidId(facilityId) &&
        isValidFacility(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        isAdmin();
      allow update: if isSignedIn() &&
        isValidId(facilityId) &&
        isValidFacility(incoming()) &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'name', 'icon', 'imageUrl', 'description', 'enabled', 'sortOrder', 'updatedAt', 'updatedBy'
        ]) &&
        isAdmin();
      allow delete: if isSignedIn() && isValidId(facilityId) && isAdmin();
    }

    match /gallery/{imageId} {
      allow get: if isValidId(imageId);
      allow list: if true;
      allow create: if isSignedIn() &&
        isValidId(imageId) &&
        isValidGalleryItem(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        isAdmin();
      allow update: if isSignedIn() &&
        isValidId(imageId) &&
        isValidGalleryItem(incoming()) &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'title', 'category', 'imageUrl', 'description', 'sortOrder', 'updatedAt', 'updatedBy'
        ]) &&
        isAdmin();
      allow delete: if isSignedIn() && isValidId(imageId) && isAdmin();
    }

    match /rules/{ruleId} {
      allow get: if isValidId(ruleId);
      allow list: if true;
      allow create: if isSignedIn() &&
        isValidId(ruleId) &&
        isValidRule(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        isAdmin();
      allow update: if isSignedIn() &&
        isValidId(ruleId) &&
        isValidRule(incoming()) &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'title', 'description', 'englishLabel', 'icon', 'variant', 'category', 'highlights',
          'sortOrder', 'enabled', 'updatedAt', 'updatedBy'
        ]) &&
        isAdmin();
      allow delete: if isSignedIn() && isValidId(ruleId) && isAdmin();
    }

    // Singleton Settings Documents
    match /settings/general {
      allow get: if true;
      allow create: if isSignedIn() &&
        isValidGeneralSettings(incoming()) &&
        incoming().updatedAt == request.time &&
        isAdmin();
      allow update: if isSignedIn() &&
        isValidGeneralSettings(incoming()) &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'lodgeName', 'lodgeNameHindi', 'introGreeting', 'introSubtitle',
          'welcomeBannerText', 'homeTagline', 'aboutLodge', 'monthlyStayInfo', 'heroImageUrl',
          'logoUrl', 'dataRetentionPolicy',
          'startingPrice', 'priceNote',
          'defaultPrice1', 'defaultPrice2', 'defaultPrice3', 'defaultPrice4',
          'defaultSecurityDeposit',
          'checkInTime', 'checkOutTime', 'updatedAt', 'updatedBy'
        ]) &&
        isAdmin();
      allow delete: if false;
    }

    match /settings/contact {
      allow get: if true;
      allow create: if isSignedIn() &&
        isValidContactSettings(incoming()) &&
        incoming().updatedAt == request.time &&
        isAdmin();
      allow update: if isSignedIn() &&
        isValidContactSettings(incoming()) &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'phone', 'whatsapp', 'email', 'otherInfo', 'updatedAt', 'updatedBy'
        ]) &&
        isAdmin();
      allow delete: if false;
    }

    match /settings/location {
      allow get: if true;
      allow create: if isSignedIn() &&
        isValidLocationSettings(incoming()) &&
        incoming().updatedAt == request.time &&
        isAdmin();
      allow update: if isSignedIn() &&
        isValidLocationSettings(incoming()) &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'address', 'landmark', 'city', 'googleMapsUrl', 'updatedAt', 'updatedBy'
        ]) &&
        isAdmin();
      allow delete: if false;
    }

    match /settings/parking {
      allow get: if true;
      allow create: if isSignedIn() &&
        isValidParkingSettings(incoming()) &&
        incoming().updatedAt == request.time &&
        isAdmin();
      allow update: if isSignedIn() &&
        isValidParkingSettings(incoming()) &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'available', 'headline', 'bikeParking', 'carParking',
          'capacity', 'rules', 'extraCharge', 'imageUrl', 'updatedAt', 'updatedBy'
        ]) &&
        isAdmin();
      allow delete: if false;
    }

    match /settings/rooftop {
      allow get: if true;
      allow create: if isSignedIn() &&
        isValidRooftopSettings(incoming()) &&
        incoming().updatedAt == request.time &&
        isAdmin();
      allow update: if isSignedIn() &&
        isValidRooftopSettings(incoming()) &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'available', 'headline', 'description', 'features', 'imageUrl', 'updatedAt', 'updatedBy'
        ]) &&
        isAdmin();
      allow delete: if false;
    }

    match /owner/profile {
      allow get: if true;
      allow create: if isSignedIn() &&
        isValidOwnerProfile(incoming()) &&
        incoming().updatedAt == request.time &&
        isAdmin();
      allow update: if isSignedIn() &&
        isValidOwnerProfile(incoming()) &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'name', 'role', 'photoUrl', 'about', 'phone', 'whatsapp', 'email', 'address', 'updatedAt', 'updatedBy'
        ]) &&
        isAdmin();
      allow delete: if false;
    }

    // =========================================================================
    // Sequential Registration Number Counter (Strictly Monotonic +1)
    // =========================================================================
    match /counters/{counterId} {
      allow get: if isValidCounterId(counterId);
      allow list: if false;
      allow create: if isValidCounterId(counterId) &&
        isValidRegistrationCounter(incoming()) &&
        incoming().lastNumber == 1 &&
        incoming().updatedAt == request.time;
      allow update: if isValidCounterId(counterId) &&
        isValidRegistrationCounter(incoming()) &&
        incoming().year == existing().year &&
        incoming().lastNumber == existing().lastNumber + 1 &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['lastNumber', 'updatedAt']);
      allow delete: if false;
    }

    // =========================================================================
    // Private PII & Admin Operations Collections
    // =========================================================================
    match /bookings/{bookingId} {
      allow get: if isSignedIn() && isValidId(bookingId) && isAdmin();
      allow list: if isSignedIn() && isAdmin();
      allow create: if isVerifiedUser() &&
        isValidId(bookingId) &&
        isValidBooking(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        isAdmin();
      allow update: if isVerifiedUser() &&
        isValidId(bookingId) &&
        isValidBooking(incoming()) &&
        incoming().createdAt == existing().createdAt &&
        incoming().userId == existing().userId &&
        incoming().updatedAt == request.time &&
        isAdmin() &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'guestName', 'guestPhone', 'roomId', 'roomName', 'guestsCount',
          'checkInDate', 'checkOutDate', 'totalAmount', 'status', 'notes', 'updatedAt'
        ]);
      allow delete: if isSignedIn() && isValidId(bookingId) && isAdmin();
    }

    // Student Stay Registrations (Public Write-Only Create; Admin-Only Read/Manage)
    match /registrations/{registrationId} {
      allow get: if isSignedIn() && isValidId(registrationId) && isAdmin();
      allow list: if isSignedIn() && isAdmin();
      allow create: if isValidId(registrationId) &&
        isValidStayRegistration(request.resource.data) &&
        !('dateOfBirth' in request.resource.data) &&
        !('email' in request.resource.data) &&
        !('parentAddress' in request.resource.data) &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time &&
        request.resource.data.status == 'submitted' &&
        isValidSubmitterUserId(request.resource.data.userId);
      allow update: if isSignedIn() &&
        isValidId(registrationId) &&
        isValidStayRegistration(request.resource.data) &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.userId == resource.data.userId &&
        request.resource.data.registrationId == resource.data.registrationId &&
        request.resource.data.registrationDateIST == resource.data.registrationDateIST &&
        request.resource.data.registrationTimeIST == resource.data.registrationTimeIST &&
        request.resource.data.updatedAt == request.time &&
        isAdmin() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'assignedRoomNumber', 'adminNotes',
          'photoStoragePath', 'signedDocFileName', 'signedDocMimeType', 'signedDocStoragePath',
          'pdfGeneratedAtIST', 'statusUpdatedAtIST', 'signedDocUploadedAtIST', 'updatedAtIST',
          'updatedAt'
        ]);
      allow delete: if isSignedIn() && isValidId(registrationId) && isAdmin();

      // Private student photo & ID proof documents:
      // - Created atomically during brand-new parent registration creation OR by verified Admin.
      // - Readable, updatable, and deletable ONLY by verified Admin (GODRIKUOP@GMAIL.COM).
      match /documents/{docId} {
        allow get: if isSignedIn() && isValidId(registrationId) && isValidId(docId) && isAdmin();
        allow list: if isSignedIn() && isValidId(registrationId) && isAdmin();
        allow create: if isValidId(registrationId) &&
          isValidId(docId) &&
          isValidRegistrationDocument(request.resource.data) &&
          request.resource.data.createdAt == request.time &&
          (
            (
              docId in ['photo', 'id_proof'] &&
              request.resource.data.docType == docId &&
              isValidSubmitterUserId(request.resource.data.userId) &&
              !exists(/databases/$(database)/documents/registrations/$(registrationId)) &&
              getAfter(/databases/$(database)/documents/registrations/$(registrationId)).data.userId == request.resource.data.userId
            ) ||
            (
              isAdmin() &&
              exists(/databases/$(database)/documents/registrations/$(registrationId)) &&
              request.resource.data.userId == get(/databases/$(database)/documents/registrations/$(registrationId)).data.userId
            )
          );
        allow update: if isSignedIn() &&
          isValidId(registrationId) &&
          isValidId(docId) &&
          isValidRegistrationDocument(request.resource.data) &&
          request.resource.data.userId == resource.data.userId &&
          isAdmin() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'fileName', 'mimeType', 'dataUrl', 'createdAt'
          ]);
        allow delete: if isSignedIn() && isValidId(registrationId) && isValidId(docId) && isAdmin();
      }
    }

    // Login-free "Find My Registration" Lookup (SHA-256 Keyed, NO List, NO ID Proof)
    match /registration_lookups/{lookupKey} {
      allow get: if isValidLookupKey(lookupKey);
      allow list: if false;
      allow create: if isValidLookupKey(lookupKey) &&
        isValidRegistrationLookup(request.resource.data) &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time &&
        request.resource.data.status == 'submitted' &&
        !exists(/databases/$(database)/documents/registrations/$(request.resource.data.registrationDocId)) &&
        getAfter(/databases/$(database)/documents/registrations/$(request.resource.data.registrationDocId)).data.lookupKey == lookupKey;
      allow update: if isSignedIn() &&
        isValidLookupKey(lookupKey) &&
        isValidRegistrationLookup(request.resource.data) &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.registrationId == resource.data.registrationId &&
        request.resource.data.registrationDocId == resource.data.registrationDocId &&
        request.resource.data.updatedAt == request.time &&
        isAdmin() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'assignedRoomNumber', 'photoDataUrl', 'updatedAt'
        ]);
      allow delete: if isSignedIn() && isValidLookupKey(lookupKey) && isAdmin();
    }

    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (
        request.auth.uid == userId || isAdmin()
      );
      allow list: if isAdmin();
      allow create: if isVerifiedUser() &&
        isValidId(userId) &&
        request.auth.uid == userId &&
        isValidUserAccount(incoming(), userId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isVerifiedUser() &&
        isValidId(userId) &&
        request.auth.uid == userId &&
        isValidUserAccount(incoming(), userId) &&
        incoming().createdAt == existing().createdAt &&
        incoming().uid == existing().uid &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'updatedAt']);
      allow delete: if isSignedIn() && isValidId(userId) && isAdmin();
    }

    match /admins/{adminId} {
      allow get: if isSignedIn() && isValidId(adminId) && (
        request.auth.uid == adminId || isAdmin()
      );
      allow list: if isAdmin();
      allow create: if isSignedIn() &&
        isValidId(adminId) &&
        isValidAdminRecord(incoming()) &&
        incoming().createdAt == request.time &&
        isAdmin();
      allow update: if false;
      allow delete: if isSignedIn() && isValidId(adminId) && isAdmin();
    }
  }
}
